# Supabase — copie para .env.local e preencha com os dados do seu projeto
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# E-mail da conta administrativa (usado pela tela "Acesso Administrativo").
# A senha NUNCA fica aqui nem no frontend: ela vive no Supabase Auth.
ADMIN_EMAIL=admin@elos.app

# Resend — envio de e-mail para líderes/crias pelo admin (server-only).
RESEND_API_KEY=
# Remetente. Até o domínio verificar na Resend, use o de testes (só entrega
# na caixa dona da conta Resend). Depois de verificado, troque para o domínio:
# "ELOS <notificacoes@seudominio.com>"
RESEND_FROM=ELOS <onboarding@resend.dev>

# Push notifications (Web Push / VAPID). Gerado uma única vez com
# `npx web-push generate-vapid-keys`. A pública é exposta ao navegador
# (NEXT_PUBLIC_*); a privada é só de servidor.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@elos.app
