# Supabase — copie para .env.local e preencha com os dados do seu projeto
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# E-mail da conta administrativa (usado pela tela "Acesso Administrativo").
# A senha NUNCA fica aqui nem no frontend: ela vive no Supabase Auth.
ADMIN_EMAIL=admin@elos.app
